PORT=7777
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/Tinder
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Email Verification (SMTP / Gmail App Password)
# If left empty, OTP codes will be printed directly to the server terminal for easy development testing
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_SERVICE=gmail

# Optional: Cloudinary Cloud Storage (Leave empty for automatic local storage fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
